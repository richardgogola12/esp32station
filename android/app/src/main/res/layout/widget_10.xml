<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="top" android:padding="12dp" android:background="@drawable/bg_good">
<include layout="@layout/widget_clock_block" />
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
  <ImageView android:layout_width="14dp" android:layout_height="14dp" android:layout_marginEnd="5dp" android:src="@drawable/ic_sensor" android:tint="#E6FFFFFF" android:importantForAccessibility="no" />
  <TextView android:id="@+id/tName" android:layout_width="0dp" android:layout_height="wrap_content" android:textColor="#DDFFFFFF" android:textSize="11sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:layout_weight="1" />
</LinearLayout>
<TextView android:id="@+id/tEmoji" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_horizontal" android:layout_marginTop="2dp" android:textSize="30sp" android:text="🙂" />
<TextView android:id="@+id/tComfort" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_horizontal" android:textColor="#FFFFFFFF" android:textSize="16sp" android:textStyle="bold" android:maxLines="1" android:text="–" />
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center" android:layout_marginTop="2dp">
  <ImageView android:layout_width="12dp" android:layout_height="12dp" android:src="@drawable/ic_thermo" android:tint="#FFFFFFFF" android:importantForAccessibility="no" />
  <TextView android:id="@+id/tTemp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFFFF" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" />
  <ImageView android:layout_width="11dp" android:layout_height="11dp" android:layout_marginStart="8dp" android:src="@drawable/ic_drop" android:tint="#FFFFFFFF" android:importantForAccessibility="no" />
  <TextView android:id="@+id/tHum" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFFFF" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" />
</LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center" android:layout_marginTop="2dp">
  <ImageView android:layout_width="11dp" android:layout_height="11dp" android:layout_marginEnd="3dp" android:src="@drawable/ic_mood" android:tint="#E6FFFFFF" android:importantForAccessibility="no" />
  <TextView android:id="@+id/tDew" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#E6FFFFFF" android:textSize="10sp" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" />
</LinearLayout>
<include layout="@layout/widget_info_block" />
</LinearLayout>
