<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="14dp" android:background="@drawable/bg_dark">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:id="@+id/tName" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="#FFFFFFFF" android:textSize="15sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/tLocation" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="#99FFFFFF" android:textSize="11sp" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
        <TextView android:id="@+id/tStatus" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="11sp" android:textStyle="bold" android:textColor="#FF22C55E" />
        <ImageView android:id="@+id/btnRefresh" android:layout_width="26dp" android:layout_height="26dp" android:padding="4dp" android:src="@drawable/ic_refresh" android:contentDescription="Obnoviť" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:gravity="bottom">
        <TextView android:id="@+id/tTemp" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#FFFDBA74" android:textSize="32sp" android:textStyle="bold" android:text="–" />
        <TextView android:id="@+id/tHum" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="14dp"
            android:textColor="#FF7DD3FC" android:textSize="24sp" android:textStyle="bold" android:text="–" />
        <TextView android:id="@+id/tMinMax" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="end"
            android:layout_marginBottom="4dp" android:textColor="#AAFFFFFF" android:textSize="11sp" android:maxLines="2" />
    </LinearLayout>
    <ImageView android:id="@+id/imgChart" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:layout_marginTop="4dp" android:scaleType="fitXY" />
    <TextView android:id="@+id/tUpdated" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="#77FFFFFF" android:textSize="10sp" android:gravity="end" />
</LinearLayout>
