<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="top" android:padding="12dp" android:background="@drawable/bg_dark">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
  <ImageView android:layout_width="16dp" android:layout_height="16dp" android:layout_marginEnd="6dp" android:src="@drawable/ic_sensor" android:tint="#FFA5B4FC" android:importantForAccessibility="no" />
  <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical"><TextView android:id="@+id/tName" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FFFFFFFF" android:textSize="14sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" /><TextView android:id="@+id/tLocation" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#99FFFFFF" android:textSize="10sp" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" /></LinearLayout>
  <ImageView android:id="@+id/iStatus" android:layout_width="12dp" android:layout_height="12dp" android:layout_marginEnd="3dp" android:src="@drawable/ic_wifi" android:tint="#FF22C55E" android:importantForAccessibility="no" />
  <TextView android:id="@+id/tStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FF22C55E" android:textSize="10sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" />
  <ImageView android:id="@+id/btnRefresh" android:layout_width="28dp" android:layout_height="28dp" android:padding="5dp" android:src="@drawable/ic_sync" android:tint="#CCFFFFFF" android:contentDescription="Obnoviť" />
</LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="6dp">
  <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_thermo" android:tint="#FFFDBA74" android:importantForAccessibility="no" />
  <TextView android:id="@+id/tTemp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFDBA74" android:textSize="28sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:text="–" android:fontFamily="sans-serif-medium" />
  <ImageView android:layout_width="18dp" android:layout_height="18dp" android:layout_marginStart="12dp" android:src="@drawable/ic_drop" android:tint="#FF7DD3FC" android:importantForAccessibility="no" />
  <TextView android:id="@+id/tHum" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FF7DD3FC" android:textSize="22sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:text="–" android:fontFamily="sans-serif-medium" />
  <TextView android:id="@+id/tTrend" android:layout_width="0dp" android:layout_height="wrap_content" android:textColor="#AAFFFFFF" android:textSize="10sp" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:layout_weight="1" android:gravity="end" />
</LinearLayout>
<ImageView android:id="@+id/imgChart" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:minHeight="24dp" android:layout_marginTop="4dp" android:scaleType="fitXY" />
<include layout="@layout/widget_info_block" />
</LinearLayout>
