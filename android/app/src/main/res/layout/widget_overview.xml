<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="14dp" android:background="@drawable/bg_widget">
  <LinearLayout android:id="@+id/rowClock" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
    <LinearLayout android:id="@+id/grpTime" android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center_vertical">
      <TextClock android:id="@+id/clockTime" android:layout_width="wrap_content" android:layout_height="wrap_content" android:format24Hour="HH:mm" android:format12Hour="HH:mm" android:textColor="#FFFFFFFF" android:textSize="30sp" android:fontFamily="sans-serif-light" android:includeFontPadding="false" />
    </LinearLayout>
    <LinearLayout android:id="@+id/grpDate" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="10dp">
      <TextClock android:layout_width="wrap_content" android:layout_height="wrap_content" android:format24Hour="EEEE" android:format12Hour="EEEE" android:textColor="#FFFFFFFF" android:textSize="13sp" android:textStyle="bold" android:includeFontPadding="false" />
      <TextClock android:id="@+id/clockDate" android:layout_width="wrap_content" android:layout_height="wrap_content" android:format24Hour="d. MMMM yyyy" android:format12Hour="d. MMMM yyyy" android:textColor="#AAFFFFFF" android:textSize="12sp" android:includeFontPadding="false" android:layout_marginTop="2dp" />
    </LinearLayout>
    <ImageView android:id="@+id/btnRefresh" android:layout_width="30dp" android:layout_height="30dp" android:padding="6dp" android:background="@drawable/bg_tile" android:src="@drawable/ic_sync" android:tint="#DDFFFFFF" android:contentDescription="Obnoviť" />
  </LinearLayout>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:layout_marginTop="10dp">
    <ImageView android:layout_width="15dp" android:layout_height="15dp" android:src="@drawable/ic_sensor" android:tint="#FFA5B4FC" android:importantForAccessibility="no" android:layout_marginEnd="6dp" />
    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:textColor="#FFFFFFFF" android:textSize="14sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:text="Moje senzory" android:layout_weight="1" />
    <TextView android:id="@+id/tCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FF22C55E" android:textSize="10sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:background="@drawable/bg_pill_ok" android:paddingStart="9dp" android:paddingEnd="9dp" android:paddingTop="3dp" android:paddingBottom="3dp" />
  </LinearLayout>
  <TextView android:id="@+id/tEmpty" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center" android:textColor="#99FFFFFF" android:textSize="12sp" android:text="Žiadne zariadenia" android:visibility="gone" />
  <LinearLayout android:id="@+id/row1" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:minHeight="42dp" android:layout_marginTop="6dp" android:background="@drawable/bg_tile" android:gravity="center_vertical" android:paddingStart="10dp" android:paddingEnd="10dp" android:visibility="gone">
    <ImageView android:id="@+id/r1Dot" android:layout_width="8dp" android:layout_height="8dp" android:src="@drawable/dot_offline" android:layout_marginEnd="8dp" />
    <LinearLayout android:layout_width="0dp" android:layout_weight="1.2" android:layout_height="wrap_content" android:orientation="vertical">
      <TextView android:id="@+id/r1Name" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FFFFFFFF" android:textSize="13sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" />
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:layout_marginTop="2dp">
        <ImageView android:layout_width="10dp" android:layout_height="10dp" android:src="@drawable/ic_place" android:tint="#FFA5B4FC" android:importantForAccessibility="no" android:layout_marginEnd="3dp" />
        <TextView android:id="@+id/r1Place" android:layout_width="0dp" android:layout_height="wrap_content" android:textColor="#AAFFFFFF" android:textSize="10sp" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:layout_weight="1" />
      </LinearLayout>
    </LinearLayout>
    <ImageView android:id="@+id/r1Spark" android:layout_width="0dp" android:layout_weight="1" android:layout_height="26dp" android:layout_marginStart="6dp" android:layout_marginEnd="8dp" android:scaleType="fitXY" />
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="end" android:minWidth="56dp">
      <TextView android:id="@+id/r1Temp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFDBA74" android:textSize="15sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" />
      <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center_vertical" android:layout_marginTop="2dp">
        <ImageView android:layout_width="10dp" android:layout_height="10dp" android:src="@drawable/ic_drop" android:tint="#FF7DD3FC" android:importantForAccessibility="no" android:layout_marginEnd="2dp" />
        <TextView android:id="@+id/r1Hum" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FF7DD3FC" android:textSize="11sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" />
      </LinearLayout>
    </LinearLayout>
  </LinearLayout>
  <LinearLayout android:id="@+id/row2" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:minHeight="42dp" android:layout_marginTop="6dp" android:background="@drawable/bg_tile" android:gravity="center_vertical" android:paddingStart="10dp" android:paddingEnd="10dp" android:visibility="gone">
    <ImageView android:id="@+id/r2Dot" android:layout_width="8dp" android:layout_height="8dp" android:src="@drawable/dot_offline" android:layout_marginEnd="8dp" />
    <LinearLayout android:layout_width="0dp" android:layout_weight="1.2" android:layout_height="wrap_content" android:orientation="vertical">
      <TextView android:id="@+id/r2Name" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FFFFFFFF" android:textSize="13sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" />
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:layout_marginTop="2dp">
        <ImageView android:layout_width="10dp" android:layout_height="10dp" android:src="@drawable/ic_place" android:tint="#FFA5B4FC" android:importantForAccessibility="no" android:layout_marginEnd="3dp" />
        <TextView android:id="@+id/r2Place" android:layout_width="0dp" android:layout_height="wrap_content" android:textColor="#AAFFFFFF" android:textSize="10sp" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:layout_weight="1" />
      </LinearLayout>
    </LinearLayout>
    <ImageView android:id="@+id/r2Spark" android:layout_width="0dp" android:layout_weight="1" android:layout_height="26dp" android:layout_marginStart="6dp" android:layout_marginEnd="8dp" android:scaleType="fitXY" />
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="end" android:minWidth="56dp">
      <TextView android:id="@+id/r2Temp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFDBA74" android:textSize="15sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" />
      <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center_vertical" android:layout_marginTop="2dp">
        <ImageView android:layout_width="10dp" android:layout_height="10dp" android:src="@drawable/ic_drop" android:tint="#FF7DD3FC" android:importantForAccessibility="no" android:layout_marginEnd="2dp" />
        <TextView android:id="@+id/r2Hum" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FF7DD3FC" android:textSize="11sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" />
      </LinearLayout>
    </LinearLayout>
  </LinearLayout>
  <LinearLayout android:id="@+id/row3" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:minHeight="42dp" android:layout_marginTop="6dp" android:background="@drawable/bg_tile" android:gravity="center_vertical" android:paddingStart="10dp" android:paddingEnd="10dp" android:visibility="gone">
    <ImageView android:id="@+id/r3Dot" android:layout_width="8dp" android:layout_height="8dp" android:src="@drawable/dot_offline" android:layout_marginEnd="8dp" />
    <LinearLayout android:layout_width="0dp" android:layout_weight="1.2" android:layout_height="wrap_content" android:orientation="vertical">
      <TextView android:id="@+id/r3Name" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FFFFFFFF" android:textSize="13sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" />
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:layout_marginTop="2dp">
        <ImageView android:layout_width="10dp" android:layout_height="10dp" android:src="@drawable/ic_place" android:tint="#FFA5B4FC" android:importantForAccessibility="no" android:layout_marginEnd="3dp" />
        <TextView android:id="@+id/r3Place" android:layout_width="0dp" android:layout_height="wrap_content" android:textColor="#AAFFFFFF" android:textSize="10sp" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:layout_weight="1" />
      </LinearLayout>
    </LinearLayout>
    <ImageView android:id="@+id/r3Spark" android:layout_width="0dp" android:layout_weight="1" android:layout_height="26dp" android:layout_marginStart="6dp" android:layout_marginEnd="8dp" android:scaleType="fitXY" />
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="end" android:minWidth="56dp">
      <TextView android:id="@+id/r3Temp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFDBA74" android:textSize="15sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" />
      <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center_vertical" android:layout_marginTop="2dp">
        <ImageView android:layout_width="10dp" android:layout_height="10dp" android:src="@drawable/ic_drop" android:tint="#FF7DD3FC" android:importantForAccessibility="no" android:layout_marginEnd="2dp" />
        <TextView android:id="@+id/r3Hum" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FF7DD3FC" android:textSize="11sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" />
      </LinearLayout>
    </LinearLayout>
  </LinearLayout>
  <LinearLayout android:id="@+id/row4" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:minHeight="42dp" android:layout_marginTop="6dp" android:background="@drawable/bg_tile" android:gravity="center_vertical" android:paddingStart="10dp" android:paddingEnd="10dp" android:visibility="gone">
    <ImageView android:id="@+id/r4Dot" android:layout_width="8dp" android:layout_height="8dp" android:src="@drawable/dot_offline" android:layout_marginEnd="8dp" />
    <LinearLayout android:layout_width="0dp" android:layout_weight="1.2" android:layout_height="wrap_content" android:orientation="vertical">
      <TextView android:id="@+id/r4Name" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FFFFFFFF" android:textSize="13sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" />
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:layout_marginTop="2dp">
        <ImageView android:layout_width="10dp" android:layout_height="10dp" android:src="@drawable/ic_place" android:tint="#FFA5B4FC" android:importantForAccessibility="no" android:layout_marginEnd="3dp" />
        <TextView android:id="@+id/r4Place" android:layout_width="0dp" android:layout_height="wrap_content" android:textColor="#AAFFFFFF" android:textSize="10sp" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:layout_weight="1" />
      </LinearLayout>
    </LinearLayout>
    <ImageView android:id="@+id/r4Spark" android:layout_width="0dp" android:layout_weight="1" android:layout_height="26dp" android:layout_marginStart="6dp" android:layout_marginEnd="8dp" android:scaleType="fitXY" />
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="end" android:minWidth="56dp">
      <TextView android:id="@+id/r4Temp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFDBA74" android:textSize="15sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" />
      <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center_vertical" android:layout_marginTop="2dp">
        <ImageView android:layout_width="10dp" android:layout_height="10dp" android:src="@drawable/ic_drop" android:tint="#FF7DD3FC" android:importantForAccessibility="no" android:layout_marginEnd="2dp" />
        <TextView android:id="@+id/r4Hum" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FF7DD3FC" android:textSize="11sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" />
      </LinearLayout>
    </LinearLayout>
  </LinearLayout>
  <LinearLayout android:id="@+id/rowUpdated" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:layout_marginTop="6dp">
    <ImageView android:layout_width="11dp" android:layout_height="11dp" android:src="@drawable/ic_sync" android:tint="#88FFFFFF" android:importantForAccessibility="no" android:layout_marginEnd="4dp" />
    <TextView android:id="@+id/tUpdatedAt" android:layout_width="0dp" android:layout_height="wrap_content" android:textColor="#99FFFFFF" android:textSize="10sp" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:layout_weight="1" />
  </LinearLayout>
</LinearLayout>
