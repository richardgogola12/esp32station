<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/infoBlock" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="4dp">
<LinearLayout android:id="@+id/rowPlace" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:visibility="gone" android:layout_marginTop="2dp">
  <ImageView android:layout_width="11dp" android:layout_height="11dp" android:layout_marginEnd="4dp" android:src="@drawable/ic_place" android:tint="#CCFFFFFF" android:importantForAccessibility="no" />
  <TextView android:id="@+id/tPlace" android:layout_width="0dp" android:layout_height="wrap_content" android:textColor="#DDFFFFFF" android:textSize="10sp" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:layout_weight="1" />
</LinearLayout>
<LinearLayout android:id="@+id/rowClock" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:visibility="gone" android:layout_marginTop="2dp">
  <LinearLayout android:id="@+id/grpTime" android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center_vertical" android:layout_marginEnd="8dp">
    <ImageView android:layout_width="11dp" android:layout_height="11dp" android:layout_marginEnd="4dp" android:src="@drawable/ic_clock" android:tint="#CCFFFFFF" android:importantForAccessibility="no" />
    <TextClock android:id="@+id/clockTime" android:layout_width="wrap_content" android:layout_height="wrap_content" android:format24Hour="HH:mm" android:format12Hour="HH:mm" android:textColor="#FFFFFFFF" android:textSize="11sp" android:textStyle="bold" android:includeFontPadding="false" />
  </LinearLayout>
  <LinearLayout android:id="@+id/grpDate" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="center_vertical">
    <ImageView android:layout_width="11dp" android:layout_height="11dp" android:layout_marginEnd="4dp" android:src="@drawable/ic_calendar" android:tint="#CCFFFFFF" android:importantForAccessibility="no" />
    <TextClock android:id="@+id/clockDate" android:layout_width="wrap_content" android:layout_height="wrap_content" android:format24Hour="EEE d. MMM yyyy" android:format12Hour="EEE d. MMM yyyy" android:textColor="#DDFFFFFF" android:textSize="10sp" android:maxLines="1" android:includeFontPadding="false" />
  </LinearLayout>
</LinearLayout>
<LinearLayout android:id="@+id/rowExtra" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:visibility="gone" android:layout_marginTop="2dp">
  <ImageView android:layout_width="11dp" android:layout_height="11dp" android:layout_marginEnd="4dp" android:src="@drawable/ic_mood" android:tint="#CCFFFFFF" android:importantForAccessibility="no" />
  <TextView android:id="@+id/tExtra" android:layout_width="0dp" android:layout_height="wrap_content" android:textColor="#DDFFFFFF" android:textSize="10sp" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:layout_weight="1" />
</LinearLayout>
<LinearLayout android:id="@+id/rowToday" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:visibility="gone" android:layout_marginTop="2dp">
  <ImageView android:layout_width="11dp" android:layout_height="11dp" android:layout_marginEnd="4dp" android:src="@drawable/ic_chart" android:tint="#CCFFFFFF" android:importantForAccessibility="no" />
  <TextView android:id="@+id/tToday" android:layout_width="0dp" android:layout_height="wrap_content" android:textColor="#DDFFFFFF" android:textSize="10sp" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:layout_weight="1" />
</LinearLayout>
<LinearLayout android:id="@+id/rowUpdated" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:visibility="gone" android:layout_marginTop="2dp">
  <ImageView android:layout_width="11dp" android:layout_height="11dp" android:layout_marginEnd="4dp" android:src="@drawable/ic_sync" android:tint="#AAFFFFFF" android:importantForAccessibility="no" />
  <TextView android:id="@+id/tUpdatedAt" android:layout_width="0dp" android:layout_height="wrap_content" android:textColor="#AAFFFFFF" android:textSize="10sp" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:layout_weight="1" />
</LinearLayout>
</LinearLayout>
