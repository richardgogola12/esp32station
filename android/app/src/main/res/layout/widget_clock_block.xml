<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/rowClock" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:visibility="gone" android:layout_marginBottom="6dp">
  <LinearLayout android:id="@+id/grpTime" android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center_vertical" android:layout_marginEnd="10dp">
    <ImageView android:layout_width="18dp" android:layout_height="18dp" android:layout_marginEnd="5dp" android:src="@drawable/ic_clock" android:tint="#E6FFFFFF" android:importantForAccessibility="no" />
    <TextClock android:id="@+id/clockTime" android:layout_width="wrap_content" android:layout_height="wrap_content" android:format24Hour="HH:mm" android:format12Hour="HH:mm" android:textColor="#FFFFFFFF" android:textSize="26sp" android:textStyle="bold" android:fontFamily="sans-serif-medium" android:includeFontPadding="false" />
  </LinearLayout>
  <LinearLayout android:id="@+id/grpDate" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="center_vertical">
    <ImageView android:layout_width="15dp" android:layout_height="15dp" android:layout_marginEnd="5dp" android:src="@drawable/ic_calendar" android:tint="#E6FFFFFF" android:importantForAccessibility="no" />
    <TextClock android:id="@+id/clockDate" android:layout_width="wrap_content" android:layout_height="wrap_content" android:format24Hour="EEEE d. MMMM" android:format12Hour="EEEE d. MMMM" android:textColor="#F2FFFFFF" android:textSize="14sp" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" />
  </LinearLayout>
</LinearLayout>
