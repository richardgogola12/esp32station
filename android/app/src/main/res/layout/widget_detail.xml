<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="14dp" android:background="@drawable/bg_widget">
  <LinearLayout android:id="@+id/rowClock" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
    <LinearLayout android:id="@+id/grpTime" android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center_vertical">
      <TextClock android:id="@+id/clockTime" android:layout_width="wrap_content" android:layout_height="wrap_content" android:format24Hour="HH:mm" android:format12Hour="HH:mm" android:textColor="#FFFFFFFF" android:textSize="32sp" android:fontFamily="sans-serif-light" android:includeFontPadding="false" />
    </LinearLayout>
    <LinearLayout android:id="@+id/grpDate" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="10dp">
      <TextClock android:layout_width="wrap_content" android:layout_height="wrap_content" android:format24Hour="EEEE" android:format12Hour="EEEE" android:textColor="#FFFFFFFF" android:textSize="13sp" android:textStyle="bold" android:includeFontPadding="false" />
      <TextClock android:id="@+id/clockDate" android:layout_width="wrap_content" android:layout_height="wrap_content" android:format24Hour="d. MMMM yyyy" android:format12Hour="d. MMMM yyyy" android:textColor="#AAFFFFFF" android:textSize="12sp" android:includeFontPadding="false" android:layout_marginTop="2dp" />
    </LinearLayout>
    <ImageView android:id="@+id/btnRefresh" android:layout_width="30dp" android:layout_height="30dp" android:padding="6dp" android:background="@drawable/bg_tile" android:src="@drawable/ic_sync" android:tint="#DDFFFFFF" android:contentDescription="Obnoviť" />
  </LinearLayout>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:layout_marginTop="10dp">
    <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/ic_sensor" android:tint="#FFA5B4FC" android:importantForAccessibility="no" android:layout_marginEnd="6dp" />
    <TextView android:id="@+id/tName" android:layout_width="0dp" android:layout_height="wrap_content" android:textColor="#FFFFFFFF" android:textSize="15sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:layout_weight="1" />
    <TextView android:id="@+id/tStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FF22C55E" android:textSize="10sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:text="online" android:background="@drawable/bg_pill_ok" android:paddingStart="9dp" android:paddingEnd="9dp" android:paddingTop="3dp" android:paddingBottom="3dp" />
  </LinearLayout>
  <LinearLayout android:id="@+id/rowPlace" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:layout_marginTop="4dp">
    <ImageView android:layout_width="13dp" android:layout_height="13dp" android:src="@drawable/ic_place" android:tint="#FFA5B4FC" android:importantForAccessibility="no" android:layout_marginEnd="5dp" />
    <TextView android:id="@+id/tPlace" android:layout_width="0dp" android:layout_height="wrap_content" android:textColor="#DDFFFFFF" android:textSize="11sp" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:layout_weight="1" />
  </LinearLayout>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp">
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_tile_temp" android:padding="10dp">
      <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center_vertical">
        <ImageView android:layout_width="13dp" android:layout_height="13dp" android:src="@drawable/ic_thermo" android:tint="#FFFB923C" android:importantForAccessibility="no" android:layout_marginEnd="4dp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#CCFFFFFF" android:textSize="11sp" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:text="Teplota" />
      </LinearLayout>
      <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="bottom" android:layout_marginTop="3dp">
        <TextView android:id="@+id/tTemp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFFFF" android:textSize="28sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:text="–" android:fontFamily="sans-serif-medium" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#AAFFFFFF" android:textSize="13sp" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:text="°C" android:layout_marginStart="2dp" android:layout_marginBottom="3dp" />
      </LinearLayout>
      <TextView android:id="@+id/tTrendT" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#AAFFFFFF" android:textSize="10sp" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:layout_marginTop="2dp" />
    </LinearLayout>
    <FrameLayout android:layout_width="8dp" android:layout_height="1dp" />
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_tile_hum" android:padding="10dp">
      <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center_vertical">
        <ImageView android:layout_width="13dp" android:layout_height="13dp" android:src="@drawable/ic_drop" android:tint="#FF38BDF8" android:importantForAccessibility="no" android:layout_marginEnd="4dp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#CCFFFFFF" android:textSize="11sp" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:text="Vlhkosť" />
      </LinearLayout>
      <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="bottom" android:layout_marginTop="3dp">
        <TextView android:id="@+id/tHum" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFFFF" android:textSize="28sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:text="–" android:fontFamily="sans-serif-medium" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#AAFFFFFF" android:textSize="13sp" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:text="%" android:layout_marginStart="2dp" android:layout_marginBottom="3dp" />
      </LinearLayout>
      <TextView android:id="@+id/tTrendH" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#AAFFFFFF" android:textSize="10sp" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:layout_marginTop="2dp" />
    </LinearLayout>
  </LinearLayout>
  <ImageView android:id="@+id/imgChart" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:minHeight="40dp" android:layout_marginTop="8dp" android:background="@drawable/bg_chart" android:scaleType="fitXY" />
  <LinearLayout android:id="@+id/rowStats" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp">
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_tile" android:paddingStart="9dp" android:paddingEnd="6dp" android:paddingTop="7dp" android:paddingBottom="7dp">
      <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center_vertical">
        <ImageView android:layout_width="11dp" android:layout_height="11dp" android:src="@drawable/ic_chart" android:tint="#FFFDBA74" android:importantForAccessibility="no" android:layout_marginEnd="4dp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#99FFFFFF" android:textSize="9sp" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:text="DNES" />
      </LinearLayout>
      <TextView android:id="@+id/tMinMax" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFFFF" android:textSize="12sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:text="–" android:layout_marginTop="3dp" />
    </LinearLayout>
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_tile" android:paddingStart="9dp" android:paddingEnd="6dp" android:paddingTop="7dp" android:paddingBottom="7dp" android:layout_marginStart="6dp">
      <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center_vertical">
        <ImageView android:layout_width="11dp" android:layout_height="11dp" android:src="@drawable/ic_drop" android:tint="#FF7DD3FC" android:importantForAccessibility="no" android:layout_marginEnd="4dp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#99FFFFFF" android:textSize="9sp" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:text="ROSNÝ BOD" />
      </LinearLayout>
      <TextView android:id="@+id/tDew" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFFFF" android:textSize="12sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:text="–" android:layout_marginTop="3dp" />
    </LinearLayout>
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_tile" android:paddingStart="9dp" android:paddingEnd="6dp" android:paddingTop="7dp" android:paddingBottom="7dp" android:layout_marginStart="6dp">
      <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center_vertical">
        <ImageView android:layout_width="11dp" android:layout_height="11dp" android:src="@drawable/ic_mood" android:tint="#FF86EFAC" android:importantForAccessibility="no" android:layout_marginEnd="4dp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#99FFFFFF" android:textSize="9sp" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:text="KOMFORT" />
      </LinearLayout>
      <TextView android:id="@+id/tComfort" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFFFF" android:textSize="12sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:text="–" android:layout_marginTop="3dp" />
    </LinearLayout>
  </LinearLayout>
  <LinearLayout android:id="@+id/rowUpdated" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:layout_marginTop="6dp">
    <ImageView android:layout_width="11dp" android:layout_height="11dp" android:src="@drawable/ic_sync" android:tint="#88FFFFFF" android:importantForAccessibility="no" android:layout_marginEnd="4dp" />
    <TextView android:id="@+id/tUpdatedAt" android:layout_width="0dp" android:layout_height="wrap_content" android:textColor="#99FFFFFF" android:textSize="10sp" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:layout_weight="1" />
  </LinearLayout>
</LinearLayout>
